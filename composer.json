{
    "name": "symfony-hexagonal/starter",
    "description": "Production-quality PHP/Symfony/API Platform starter with Hexagonal Architecture, CQRS, and DDD",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,

    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "api-platform/core": "^4.0",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/migrations": "^3.7",
        "doctrine/orm": "^3.3",
        "ramsey/uuid": "^4.7",
        "symfony/cache": "^7.1",
        "symfony/console": "^7.1",
        "symfony/dotenv": "^7.1",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "^7.1",
        "symfony/http-client": "^7.1",
        "symfony/lock": "^7.1",
        "symfony/mailer": "^7.1",
        "symfony/messenger": "^7.1",
        "symfony/rate-limiter": "^7.1",
        "symfony/runtime": "^7.1",
        "symfony/scheduler": "^7.1",
        "symfony/security-bundle": "^7.1",
        "symfony/serializer": "^7.1",
        "symfony/uid": "^7.1",
        "symfony/validator": "^7.1",
        "symfony/yaml": "^7.1"
    },

    "require-dev": {
        "behat/behat": "^3.14",
        "behat/mink-extension": "^2.3",
        "behatch/contexts": "^3.0",
        "dama/doctrine-test-bundle": "^8.0",
        "friends-of-behat/symfony-extension": "^2.4",
        "friendsofphp/php-cs-fixer": "^3.59",
        "infection/infection": "^0.29",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-symfony": "^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.4",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "^7.1",
        "symfony/css-selector": "^7.1",
        "zenstruck/foundry": "^2.1"
    },

    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true,
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },

    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },

    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"],

        "lint":       "vendor/bin/phpcs",
        "cs-fix":     "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "cs-check":   "vendor/bin/php-cs-fixer fix --allow-risky=yes --dry-run --diff",
        "analyze":    "vendor/bin/phpstan analyse --memory-limit=512M",
        "rector":     "vendor/bin/rector process",
        "rector-dry": "vendor/bin/rector process --dry-run",
        "test":       "vendor/bin/pest",
        "test-unit":  "vendor/bin/pest --testsuite=Unit",
        "test-int":   "vendor/bin/pest --testsuite=Integration",
        "test-e2e":   "vendor/bin/behat",
        "mutation":   "vendor/bin/infection --threads=4"
    },

    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.1.*"
        }
    }
}
