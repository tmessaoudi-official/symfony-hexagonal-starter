###
# Test environment overrides.
# This file is committed to git — do NOT put secrets here.
# Values here override .env when APP_ENV=test (loaded by Dotenv::bootEnv).
###

APP_ENV=test
APP_DEBUG=1

###> doctrine/doctrine-bundle ###
# Uses the same postgres service, but the _test database.
# The docker-compose.test.yml service sets this via environment: — this file
# is the fallback for running tests locally without compose (e.g. via make test-unit
# which doesn't need a DB, or when a local postgres is available).
DATABASE_URL="postgresql://app:app@localhost:5432/app_test?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# In-memory transport for all tests — no RabbitMQ required.
MESSENGER_TRANSPORT_DSN=in-memory://
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=test@example.com
MAILER_FROM_NAME="Test"
###< symfony/mailer ###
