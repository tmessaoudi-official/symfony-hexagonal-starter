# phpstan-symfony and phpstan-doctrine are registered automatically by
# phpstan/extension-installer: no includes needed.

parameters:
    # Level 8 of 0-10: every check up to strict null-safety (calling a method on a
    # possibly-null value is an error). Levels 9 and 10 add checks on mixed.
    level: 8

    paths:
        - src
        - tests

    # ─── Symfony ──────────────────────────────────────────────────────────────
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
        # If the container XML doesn't exist yet (fresh install), generate it:
        # bin/console cache:warmup --env=dev

    # ─── Doctrine ─────────────────────────────────────────────────────────────
    doctrine:
        objectManagerLoader: tests/doctrine-object-manager.php

    # ─── Type extensions ──────────────────────────────────────────────────────
    treatPhpDocTypesAsCertain: false
