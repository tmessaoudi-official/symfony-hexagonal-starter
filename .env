###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changethis_in_production_use_32_char_random_string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:app@postgres:5432/app?serverVersion=19&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM_ADDRESS=noreply@example.com
MAILER_FROM_NAME="Symfony Starter"
###< symfony/mailer ###

###> Cache / Redis ###
REDIS_URL=redis://redis:6379
###< Cache / Redis ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
