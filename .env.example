###> symfony/framework-bundle ###
APP_ENV=prod
# Generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=REPLACE_WITH_32_CHAR_RANDOM_HEX
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?serverVersion=19&charset=utf8
DATABASE_URL="postgresql://app:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/app?serverVersion=19&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# RabbitMQ: amqp://USER:PASSWORD@HOST:5672/%2f/messages
# SQS:     sqs://ACCESS_KEY:SECRET@sqs.eu-west-1.amazonaws.com?region=eu-west-1
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
###< symfony/messenger ###

###> symfony/mailer ###
# Mailpit (local): smtp://mailpit:1025
# Mailgun: mailgun+https://KEY:DOMAIN@default
# SES:     ses+smtp://ACCESS_KEY:SECRET_KEY@default?region=eu-west-1
MAILER_DSN=smtp://localhost:1025
MAILER_FROM_ADDRESS=noreply@yourdomain.com
MAILER_FROM_NAME="Your App Name"
###< symfony/mailer ###

###> Cache / Redis ###
REDIS_URL=redis://localhost:6379
###< Cache / Redis ###
